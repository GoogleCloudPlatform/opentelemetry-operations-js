{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:js-lib",
    "group:allNonMajor"
  ],
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "typescript"
      ],
      "groupName": "typescript"
    },
    {
      "matchPackageNames": [
        "mocha",
        "ts-mocha",
        "@types/mocha"
      ],
      "groupName": "mocha"
    },
    {
      "groupName": "opentelemetry upstream",
      "matchPackageNames": [
        "@opentelemetry/{/,}**"
      ]
    },
    {
      "groupName": "nx",
      "matchPackageNames": [
        "@nx/{/,}**",
        "nx{/,}**"
      ]
    },
    {
      "matchPackageNames": [
        "fastify"
      ],
      "groupName": "fastify"
    },
    // Block google-auth-library updates to prevent duplicate nested package installs
    // and TS2769 nominal type errors until googleapis-common (googleapis/google-cloud-node)
    // upgrades or unpins its exact google-auth-library@10.5.0 dependency.
    {
      "matchPackageNames": [
        "google-auth-library"
      ],
      "enabled": false
    }
  ]
}
